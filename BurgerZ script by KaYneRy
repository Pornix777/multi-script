local mainRenderLoop = RunService.RenderStepped:Connect(function()
    FOVCircle.Radius = Settings.FovRadius
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    if Settings.FullbrightEnabled then
        Lighting.Brightness = 2; Lighting.ClockTime = 14; Lighting.Ambient = Color3.fromRGB(255, 255, 255)
    else
        Lighting.Brightness = origBrightness; Lighting.ClockTime = origClockTime; Lighting.Ambient = origAmbient
    end

    if Settings.MenuVisible then
        TextFov.Text = "FOV Radius: " .. Settings.FovRadius
        BtnAimBg.Color = Settings.AimbotEnabled and Colors.BtnOn or Colors.BtnOff
        TextAim.Text = Settings.AimbotEnabled and "Aimbot: ON (Key: Q)" or "Aimbot: OFF (Key: Q)"
        BtnEspBg.Color = Settings.EspEnabled and Colors.BtnOn or Colors.BtnOff
        TextEsp.Text = Settings.EspEnabled and "ESP: ON" or "ESP: OFF"
        BtnBrightBg.Color = Settings.FullbrightEnabled and Colors.BtnOn or Colors.BtnOff
        TextBright.Text = Settings.FullbrightEnabled and "Fullbright: ON (Key: B)" or "Fullbright: OFF (Key: B)"
        BtnCamBg.Color = Settings.FreecamEnabled and Colors.BtnOn or Colors.BtnOff
        TextCam.Text = Settings.FreecamEnabled and "Freecam: ON (Key: V)" or "Freecam: OFF (Key: V)"
        BtnNoclipBg.Color = Settings.NoclipEnabled and Colors.BtnOn or Colors.BtnOff
        TextNoclip.Text = Settings.NoclipEnabled and "Noclip: ON (Key: N)" or "Noclip: OFF (Key: N)"
        BtnClickBg.Color = Settings.AutoclickEnabled and Colors.BtnOn or Colors.BtnOff
        TextClick.Text = Settings.AutoclickEnabled and "Autoclicker: ON (Key: G)" or "Autoclicker: OFF (Key: G)"
        
        -- Рендер новой кнопки фильтрации по Команде
        BtnTeamBg.Color = Settings.IgnoreTeam and Colors.BtnOn or Colors.BtnOff
        TextTeam.Text = Settings.IgnoreTeam and "Ignore Team: ON" or "Ignore Team: OFF"
    end

    if not Settings.FreecamEnabled then
        local target = Settings.FriendAimEnabled and getClosestPlayer(true) or (Settings.AimbotEnabled and getClosestPlayer(false))
        if target and target.Character and target.Character:FindFirstChild("Head") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character.Head.Position)
        end
    end
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local data, char = espCache[p], p.Character
            
            -- Проверяем, нужно ли убирать ESP с союзников по табу
            local shouldShowEsp = Settings.EspEnabled and not isTeammate(p)
            
            if shouldShowEsp and data and char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Head") and char:FindFirstChild("Humanoid") then
                local humanoid, rootPart, head = char.Humanoid, char.HumanoidRootPart, char.Head
                if humanoid.Health > 0 then
                    -- Назначаем цвета: синий для вайтлиста, зеленый для остальных
                    local color = isBluePlayer(p) and Colors.AllyBlue or Colors.EnemyGreen
                    data.Box.Color = color
                    if not char:FindFirstChild("EspHighlight") then data.Highlight.Parent = char; data.Highlight.Name = "EspHighlight" end
                    data.Highlight.OutlineColor = color
                    
                    local rPos, rOnScreen = Camera:WorldToViewportPoint(rootPart.Position)
                    if rOnScreen then
                        local hPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                        local lPos = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
                        local height = math.abs(hPos.Y - lPos.Y); local width = height / 2
                        data.Box.Size = Vector2.new(width, height); data.Box.Position = Vector2.new(rPos.X - width / 2, hPos.Y); data.Box.Visible = true
                        data.Text.Text = p.Name .. " [" .. math.floor(humanoid.Health) .. " HP]"; data.Text.Position = Vector2.new(rPos.X, hPos.Y - 18); data.Text.Visible = true
                    else data.Box.Visible = false; data.Text.Visible = false end
                else data.Box.Visible = false; data.Text.Visible = false; if char:FindFirstChild("EspHighlight") then data.Highlight.Parent = nil end end
            else 
                if data then 
                    data.Box.Visible = false; data.Text.Visible = false
                    if char and char:FindFirstChild("EspHighlight") then data.Highlight.Parent = nil end 
                end 
            end
        end
    end
end)

local keyboardInputConn
keyboardInputConn = UserInputService.InputBegan:Connect(function(input, processed)
    if input.KeyCode == Settings.FriendAimKey then Settings.FriendAimEnabled = true end
    if processed then return end

    if input.KeyCode == Settings.MenuKey then 
        setMenuVisibility(not Settings.MenuVisible)
        UserInputService.MouseBehavior = (Settings.MenuVisible and Settings.FreecamEnabled) and Enum.MouseBehavior.Default or (Settings.FreecamEnabled and Enum.MouseBehavior.LockCurrentPosition or UserInputService.MouseBehavior)
    elseif input.KeyCode == Enum.KeyCode.H then -- Секретный бинд: переключение фильтра тиммейтов на H
        Settings.IgnoreTeam = not Settings.IgnoreTeam
    elseif input.KeyCode == Settings.FreecamKey then toggleFreecam(not Settings.FreecamEnabled)
    elseif input.KeyCode == Settings.FullbrightKey then Settings.FullbrightEnabled = not Settings.FullbrightEnabled
    elseif input.KeyCode == Settings.NoclipKey then Settings.NoclipEnabled = not Settings.NoclipEnabled
    elseif input.KeyCode == Settings.AutoclickKey then Settings.AutoclickEnabled = not Settings.AutoclickEnabled
    elseif input.KeyCode == Settings.AimbotKey and not Settings.FreecamEnabled then Settings.AimbotEnabled = not Settings.AimbotEnabled
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 and Settings.MenuVisible then
        local mPos = UserInputService:GetMouseLocation()
        if isMouseInArea(mPos, BtnAimBg.Position, BtnAimBg.Size) then Settings.AimbotEnabled = not Settings.AimbotEnabled
        elseif isMouseInArea(mPos, BtnEspBg.Position, BtnEspBg.Size) then Settings.EspEnabled = not Settings.EspEnabled
        elseif isMouseInArea(mPos, BtnBrightBg.Position, BtnBrightBg.Size) then Settings.FullbrightEnabled = not Settings.FullbrightEnabled
        elseif isMouseInArea(mPos, BtnNoclipBg.Position, BtnNoclipBg.Size) then Settings.NoclipEnabled = not Settings.NoclipEnabled
        elseif isMouseInArea(mPos, BtnClickBg.Position, BtnClickBg.Size) then Settings.AutoclickEnabled = not Settings.AutoclickEnabled
        elseif isMouseInArea(mPos, BtnTeamBg.Position, BtnTeamBg.Size) then Settings.IgnoreTeam = not Settings.IgnoreTeam -- Клик по кнопке Team
        elseif isMouseInArea(mPos, BtnCamBg.Position, BtnCamBg.Size) then toggleFreecam(not Settings.FreecamEnabled)
        elseif isMouseInArea(mPos, BtnMinus.Position, BtnMinus.Size) then if Settings.FovRadius > 25 then Settings.FovRadius = Settings.FovRadius - 25 end
        elseif isMouseInArea(mPos, BtnPlus.Position, BtnPlus.Size) then if Settings.FovRadius < 1000 then Settings.FovRadius = Settings.FovRadius + 25 end end
    elseif input.KeyCode == Settings.ExitKey then
        runningScript = false; mainRenderLoop:Disconnect(); noclipConnection:Disconnect(); inputBeganConn:Disconnect(); inputChangedConn:Disconnect(); inputEndedConn:Disconnect(); keyboardInputConn:Disconnect(); pAdded:Disconnect(); pRemoved:Disconnect()
        if Settings.FreecamEnabled then toggleFreecam(false) end
        Lighting.Brightness = origBrightness; Lighting.ClockTime = origClockTime; Lighting.Ambient = origAmbient
        for _, p in ipairs(Players:GetPlayers()) do removeESP(p) end
        for _, obj in ipairs(allObjects) do pcall(function() obj:Remove() end) end
        FOVCircle:Remove()
    end
end)

