local function isBluePlayer(player)
    local name = player.Name:lower()
    local displayName = player.DisplayName:lower()
    local cleanDisplayName = displayName:sub(1,1) == "@" and displayName:sub(2) or displayName
    return BluePlayers[name] or BluePlayers[displayName] or BluePlayers[cleanDisplayName]
end

-- Проверка на то, является ли игрок союзником по команде (в Табе)
local function isTeammate(player)
    if not Settings.IgnoreTeam then return false end
    if player.Team == LocalPlayer.Team and LocalPlayer.Team ~= nil then
        return true
    end
    return false
end

