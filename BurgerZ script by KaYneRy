local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local Camera = Workspace.CurrentCamera

local allVisuals = {}

local function createObj(type, props)
    local obj = Drawing.new(type)
    for k, v in pairs(props) do 
        obj[k] = v 
    end
    table.insert(allVisuals, obj)
    return obj
end

-- Получаем центр экрана
local screenSize = Camera.ViewportSize
local screenCenter = Vector2.new(screenSize.X / 2, screenSize.Y / 2)

-- 1. Полупрозрачный темный фон на весь экран
local Background = createObj("Square", {
    Size = screenSize,
    Position = Vector2.new(0, 0),
    Color = Color3.fromRGB(15, 15, 15),
    Filled = true,
    Transparency = 0.85,
    Visible = true
})

-- 2. Огромный красный текст по центру
local DeniedText = createObj("Text", {
    Text = "ХУЙ ТЕБЕ ЧИТАК ЕБАНЫЙ!",
    Size = 50, -- Очень крупный шрифт
    Center = true,
    Position = screenCenter - Vector2.new(0, 36), -- Выравнивание по центру
    Color = Color3.fromRGB(255, 50, 50), -- Ярко-красный цвет
    Outline = true,
    OutlineColor = Color3.fromRGB(0, 0, 0),
    Visible = true
})
-- Логика закрытия экрана по кнопке Enter
local connection
connection = UserInputService.InputBegan:Connect(function(input, processed)
    if input.KeyCode == Enum.KeyCode.Return then -- Клавиша Enter
        -- Удаляем все объекты из памяти
        for _, obj in ipairs(allVisuals) do
            pcall(function() obj:Remove() end)
        end
        connection:Disconnect()
    end
end)
