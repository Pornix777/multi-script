local fcCFrame, fcConnection = Camera.CFrame, nil
local cameraRot = Vector2.new()

local function toggleFreecam(state)
    Settings.FreecamEnabled = state
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if state then
        fcCFrame = Camera.CFrame; Camera.CameraType = Enum.CameraType.Scriptable
        if root then root.Anchored = true end
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
        local look = fcCFrame.LookVector
        cameraRot = Vector2.new(math.atan2(-look.X, -look.Z), math.asin(look.Y))
        fcConnection = RunService.RenderStepped:Connect(function(dt)
            local speed = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 120 or 40
            local mv = Vector3.new()
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then mv = mv + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then mv = mv - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then mv = mv - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then mv = mv + Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then mv = mv + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then mv = mv - Vector3.new(0, 1, 0) end
            fcCFrame = fcCFrame + (mv * speed * dt)
            local md = UserInputService:GetMouseDelta()
            cameraRot = cameraRot - Vector2.new(md.X * 0.003, md.Y * 0.003)
            local pitch = math.clamp(cameraRot.Y, -math.rad(85), math.rad(85))
            Camera.CFrame = CFrame.new(fcCFrame.Position) * CFrame.Angles(0, cameraRot.X, 0) * CFrame.Angles(pitch, 0, 0)
        end)
    else
        if fcConnection then fcConnection:Disconnect() end
        Camera.CameraType = Enum.CameraType.Custom; if root then root.Anchored = false end
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end
end

